# Copy this file to .env and fill in the values. Only DATABASE_URL and JWT_SECRET are required.

PORT=5000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecommerce_db"

# Required: long random string used to sign login tokens
JWT_SECRET=

# Admin login (http://localhost:5173/admin/login). Created when the server starts and by
# `npx prisma db seed`; re-running the seed sets the password to the value here.
# (Public sign-up only creates buyers.)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional demo shopper login (http://localhost:5173/auth), created by `npx prisma db seed`
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
DEMO_BUYER_NAME=Demo Buyer

# Optional demo seller login, with its own approved store "Urban Trend Co.", created by `npx prisma db seed`
DEMO_SELLER_EMAIL=
DEMO_SELLER_PASSWORD=
DEMO_SELLER_NAME=Demo Seller

# ---------- Payments (Stripe test keys: https://dashboard.stripe.com/test/apikeys) ----------
STRIPE_SECRET_KEY=sk_test_...
# Printed by: stripe listen --forward-to localhost:5000/api/v1/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# Currency Stripe charges in; product prices are in rupees
CURRENCY=inr

# Razorpay (UPI, cards, net banking): test keys from https://dashboard.razorpay.com/app/keys
# The UPI option only appears at checkout once both keys are set.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
# From a Razorpay webhook pointing at https://<your-api>/api/v1/webhook/razorpay (events: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# ---------- Store rules ----------
# Orders below FREE_DELIVERY_THRESHOLD (rupees) pay DELIVERY_FEE
DELIVERY_FEE=40
FREE_DELIVERY_THRESHOLD=499
# Days after delivery during which items can be returned
RETURN_WINDOW_DAYS=7
# Share of each sale kept from marketplace sellers (0.1 = 10%); can be changed per seller in the admin dashboard
DEFAULT_COMMISSION_RATE=0.1
# Seller name shown on the store's own products
PLATFORM_SELLER_NAME=Shoyo Retail
# Where the store's own products ship from (for delivery estimates)
WAREHOUSE_PINCODE=560001
# Receives contact-form messages and new-seller applications (defaults to ADMIN_EMAIL)
SUPPORT_EMAIL=

# ---------- URLs ----------
# Storefront URL (payment redirects and links in emails)
CLIENT_URL=http://localhost:5173
# Admin panel URL (links in admin emails)
ADMIN_URL=http://localhost:5174
# Browser origins allowed to call the API, comma-separated (defaults to CLIENT_URL and ADMIN_URL)
CORS_ORIGINS=
# Public URL of this backend, so Stripe can show uploaded images (leave empty locally)
PUBLIC_BACKEND_URL=
# Set to true when running behind a proxy or load balancer (Render, Railway, Nginx)
TRUST_PROXY=false

# ---------- Email ----------
# Without SMTP_HOST, emails are saved as .html files in backend/outbox/ instead of being sent
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shoyo <no-reply@shoyo.test>"

# ---------- Cache, rate limits, logging (all optional) ----------
# Redis for the product cache, e.g. redis://localhost:6379 (without it, an in-memory cache is used)
REDIS_URL=
CACHE_TTL_SECONDS=60
# Requests per IP per 15 minutes
API_RATE_LIMIT=1000
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=20
# trace, debug, info, warn, error or silent
LOG_LEVEL=info

# ---------- Tests ----------
# Database used by `npm test` (defaults to DATABASE_URL with the name changed to ecommerce_test)
TEST_DATABASE_URL=
